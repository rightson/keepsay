<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CI and local ad-hoc builds (Hardened Runtime, no Team ID). Without
  keychain-access-groups, core's vault returns Unsupported from store_key
  (docs/changes/0008); everything else works. Never distribute this build.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
